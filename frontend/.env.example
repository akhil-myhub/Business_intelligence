# Copy to .env.local (dev) or inject via your orchestrator (prod). All values are optional;
# invalid values fall back to safe defaults (see src/config/env.js).

APP_VERSION=1.0.0

# debug | info | warn | error | silent   (default: debug in dev, info in prod)
LOG_LEVEL=info
# Browser log threshold (must be NEXT_PUBLIC_ to reach the client)
NEXT_PUBLIC_LOG_LEVEL=info

# Input limits
QUERY_MAX_LENGTH=500
LOG_BODY_MAX_BYTES=16384

# Abuse protection (per client IP, per instance)
QUERY_RATE_PER_MIN=30
LOG_RATE_PER_MIN=120

# Streaming
QUERY_STEP_DELAY_MS=700
SSE_HEARTBEAT_MS=10000
