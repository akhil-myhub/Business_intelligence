# Copy to .env.local (dev) or inject via your orchestrator (prod). Invalid values fall back to safe defaults
# (see src/config/env.js and src/config/auth.js).

APP_VERSION=1.0.0

# ── Authentication ───────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION: sign-in is disabled (HTTP 503) unless all three are set.
# Development falls back to: demo@businessai.app / Business@2026 with a built-in dev secret.
SESSION_SECRET=            # >= 32 random characters:  openssl rand -base64 48
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
SESSION_TTL_SEC=28800      # 8h; "Remember me" keeps the session for 7 days
LOGIN_RATE_PER_MIN=10
SHOW_DEMO_HINT=0           # 1 shows the demo credentials on the login page (never in real production)

# ── Logging ──────────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent   (default: debug in dev, info in prod)
LOG_LEVEL=info
NEXT_PUBLIC_LOG_LEVEL=info  # browser threshold (must be NEXT_PUBLIC_ to reach the client)

# ── Limits ───────────────────────────────────────────────────────────────────────
QUERY_MAX_LENGTH=500
LOG_BODY_MAX_BYTES=16384
QUERY_RATE_PER_MIN=30
LOG_RATE_PER_MIN=120

# ── Streaming ────────────────────────────────────────────────────────────────────
QUERY_STEP_DELAY_MS=700    # pacing of the "thinking" stages (UX only)
SSE_HEARTBEAT_MS=10000
LIVE_TICK_MS=2000          # live feed cadence
LIVE_SPEEDUP=40            # 1 = real time; higher compresses business time so the demo visibly moves
