# Copy to .env - never commit real values.
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO
SESSION_SECRET=                # >= 32 random characters; must match the frontend value
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=                  # e.g. postgresql+asyncpg://user:pass@host:5432/businessai
REDIS_URL=                     # rate limiting / live-feed fan-out
LLM_PROVIDER=                  # question-answering service (optional)
